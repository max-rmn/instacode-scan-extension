{
  "manifest_version": 3,
  "name": "Instacode Scan",
  "version": "1.0.0",
  "description": "Scanne tes abonnés/abonnements Instagram (dans ton navigateur) et les envoie au panneau Instacode.",
  "permissions": [
    "storage",
    "scripting",
    "cookies"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.instagram.com/*",
    "https://instacode-panel.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Instacode Scan"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Ouvrir Instacode Scan"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://*.instagram.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
